generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  inquiries Inquiry[]
}

model Inquiry {
  id           String   @id @default(cuid())
  type         String
  message      String?
  productSlug  String?
  donationCents Int?
  source       String?
  createdAt    DateTime @default(now())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  retreatLink RetreatInquiry?
}

model Retreat {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  createdAt DateTime @default(now())

  inquiries RetreatInquiry[]
}

model RetreatInquiry {
  id        String @id @default(cuid())
  inquiryId String @unique
  retreatId String

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  retreat Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@index([retreatId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  photos      String[] @default([])
  startAt     DateTime
  endAt       DateTime?

  // Recurring
  isRecurring Boolean  @default(false)
  rrule       String?  // e.g. "monthly:1,3:3" = 1st+3rd Wednesday
  exceptions  String[] @default([]) // ISO date strings of skipped instances

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt])
  @@index([isRecurring])
}

model EventMember {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}